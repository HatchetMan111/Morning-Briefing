# ---- Telegram (optional, für Zustellung) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- LLM-Provider (mind. einen konfigurieren) ----
# Auswahl: gemini | openrouter | ollama
LLM_PROVIDER=gemini

# Gemini (kostenlos: https://aistudio.google.com -> Get API key)
GEMINI_API_KEY=

# OpenRouter (https://openrouter.ai – viele Modelle, auch kostenlose)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Ollama (lokal, keine Cloud nötig – http://localhost:11434)
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

# ---- eBay Browse API (optional, für Preis-Tracker) ----
# Kostenloses Developer-Konto: https://developer.ebay.com
EBAY_BEARER_TOKEN=

# ---- Tankerkönig (optional, für Spritpreise) ----
# Kostenloser Key: https://creativecommons.tankerkoenig.de/
TANKERKOENIG_API_KEY=
