# ---- Telegram (erforderlich für Zustellung) ----
# 1. Bei @BotFather "/newbot" -> Token kopieren
# 2. Dem Bot einmal schreiben, dann Chat-ID ermitteln
#    (https://api.telegram.org/bot<TOKEN>/getUpdates -> "chat":{"id":...})
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Google Gemini (erforderlich für KI-Zusammenfassungen) ----
# Kostenlos: https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=

# ---- eBay Browse API (optional) ----
# Kostenloses Developer-Konto: https://developer.ebay.com
# OAuth "User Token" generieren und hier einfügen
EBAY_BEARER_TOKEN=
